# Docker defaults. For native local use: DATABASE_URL=sqlite:///./var/docverify.db
DATABASE_URL=postgresql+psycopg://docverify:docverify_local@db:5432/docverify
POSTGRES_PASSWORD=docverify_local
WEB_PORT=3000
STORAGE_DIR=/data/uploads
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
DEMO_MODE=true
MAX_FILE_MB=10
MAX_PAGES=30
JOB_LEASE_SECONDS=300
JOB_MAX_ATTEMPTS=3
# Backend only. Empty key keeps evidence search fully functional.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Opt-in: install backend/requirements-semantic.txt first.
SEMANTIC_ENABLED=false
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_LOCAL_ONLY=true
EMBEDDING_REVISION=
# Optional overrides; otherwise the checked-in validation-selected lexical threshold is used.
KEYWORD_MIN_SCORE=0.035
SEMANTIC_MIN_SCORE=0.3
# Next server internal proxy destination; never a browser secret.
BACKEND_URL=http://backend:8000
